# Build + tooling
node_modules/
_site/
*.log
.DS_Store

# Local notes, not part of the site
CLAUDE.md
_Archive/

# Large source originals stay on disk but out of the repo. The optimised WebP
# versions in src/assets/ are committed and are what the site actually serves.
# Keep your own backup of these — a fresh clone will not include them.
_source/facility/photo/
_source/originals/

# Large source PDFs (drawings, scans). Keep them locally; they are inputs,
# not site content, and a 60 MB blob lives in git history forever.
_source/**/*.drawio.pdf
_source/facility/UA HUBS LAB RENOVATION*.pdf
