---
layout: base.njk
title: false
showCard: true
disclaimer: >-
  <strong>About Fig. 1.</strong> A design fiction, not a deployed system or
  measured data. It illustrates a research direction — agentic reasoning coupled
  to physical actuation — and the numbers are plausible placeholders chosen to
  make the three-way coupling legible.
---
{% from "icons.njk" import icon %}
{% macro partyClass(p) %}{{ 'c-hu' if p == 'human' else ('c-ai' if p == 'ai' else 'c-bl') }}{% endmacro %}

<!-- ===== Hero + exchange ============================================ -->
<section class="hero wrap" id="exchange">
  <p class="label">{{ site.researchArea }}</p>
  <h1>
    {%- for part in site.headline %}
    <span class="{{ partyClass(part.party) | trim }}">{{ part.text }}</span>
    {%- endfor %}
  </h1>
  <p class="lede">{{ site.lede }}</p>

  <div class="stageWrap">
    <div class="stageBar">
      <span class="label">{{ exchange.caption }}</span>
      <div class="controls">
        <div class="dots" id="dots" aria-hidden="true"></div>
        <button class="ctl" id="prev" type="button" disabled>Back</button>
        {# data-primary is set here too so the button is already loud on first
           paint, before main.js takes over rendering it. #}
        <button class="ctl ctl--go" id="next" type="button" data-primary="true">▶&nbsp;&nbsp;Run the exchange</button>
      </div>
    </div>

    <div class="stage">
      <div class="trace">
        <div class="lanes" aria-hidden="true">
          <span class="c-hu">Human</span><span></span>
          <span class="c-ai">AI</span><span></span>
          <span class="c-bl">Building</span>
        </div>
        <div class="rows" id="rows" aria-live="polite">
          <div class="axisMid" aria-hidden="true"></div>
        </div>
      </div>

      <aside class="statePanel">
        <h2>Building state</h2>
        <div class="readout" id="readout"></div>
      </aside>
    </div>
  </div>
</section>

{# The conversation is data. Edit src/_data/exchange.yml, never the JS. #}
<script type="application/json" id="exchange-data">{{ { "steps": exchange.steps, "fields": exchange.fields } | jsonScript | safe }}</script>

<!-- ===== Three edges ================================================ -->
<section class="band band--rule wrap" id="edges">
  <div class="band__head measure">
    <p class="label">The shape of the problem</p>
    <h2>A triangle, not a control loop.</h2>
    <p class="lede">{{ edges.intro }}</p>
  </div>

  <div class="edges">
    {%- for e in edges.edges %}
    <div class="edge">
      <div class="edge__side right">
        <p class="edge__t {{ partyClass(e.left.party) | trim }}">{{ e.left.title }}</p>
        <p class="edge__d">{{ e.left.text }}</p>
      </div>
      <div class="edge__mid"><b>⇄</b><i>Edge {{ e.n }}</i></div>
      <div class="edge__side">
        <p class="edge__t {{ partyClass(e.right.party) | trim }}">{{ e.right.title }}</p>
        <p class="edge__d">{{ e.right.text }}</p>
      </div>
    </div>
    {%- endfor %}
  </div>

  <p class="punchline">
    {{ edges.closing.lead }}<br />
    <span class="c-ai">{{ edges.closing.punch }}</span>
  </p>
</section>

<!-- ===== Scale explorer ============================================= -->
<section class="band band--rule wrap" id="scales">
  <div class="band__head measure">
    <p class="label">The portfolio</p>
    <h2>The same triangle, at five scales.</h2>
    <p class="lede">{{ scales.intro }}</p>
  </div>

  <div class="segmented" role="tablist" aria-label="Research scale">
    {%- for s in scales.scales %}
    <button class="seg" role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" data-i="{{ loop.index0 }}">{{ s.tab }}</button>
    {%- endfor %}
  </div>

  <div class="scales">
    <div class="scaleViz">
      {# Decorative. The scale's meaning is carried by the panel text beside it. #}
      <canvas id="scaleCanvas" aria-hidden="true"></canvas>
    </div>
    <div class="panel" id="panel" aria-live="polite"></div>
  </div>

  <div class="btnRow">
    <a class="btn btn--quiet" href="/research/">Projects, publications &amp; software {{ icon("arrow-right") }}</a>
  </div>
</section>

<script type="application/json" id="scales-data">{{ scales.scales | jsonScript | safe }}</script>

<!-- ===== Recent news ================================================ -->
<section class="band band--rule wrap">
  <div class="band__head measure">
    <p class="label">Lab news</p>
    <h2>What's happening.</h2>
  </div>

  <ul class="news">
    {%- for item in news | byDateDesc | limit(6) %}
    <li>
      <span class="date">{{ item.date | slashDate }}</span>
      <div>
        <p>{{ item.text | safe }}</p>
        {% if item.type %}<span class="kind">{{ item.type }}</span>{% endif %}
      </div>
    </li>
    {%- endfor %}
  </ul>

  <div class="btnRow">
    <a class="btn btn--quiet" href="/news/">All news &amp; archive {{ icon("arrow-right") }}</a>
  </div>
</section>

<!-- ===== CTA ======================================================== -->
<section class="band wrap" id="join">
  <div class="cta">
    <p class="label">Join us</p>
    <h2 style="margin-top:.8rem">We need people who can work on all three corners.</h2>
    <p style="color:var(--ink-2);max-width:56ch;margin-top:1rem">
      Agents and reasoning, sensing and actuation hardware, building physics, and
      the human-subject work that keeps all three honest. PhD, master's, and
      undergraduate positions in {{ site.department }}, {{ site.university }}.
    </p>
    <div class="btnRow">
      <a class="btn" href="/join-us/">How to apply {{ icon("arrow-right") }}</a>
      <a class="btn btn--quiet" href="mailto:{{ site.contact.email }}">Email Dr. Jung</a>
    </div>
  </div>
</section>
