---
# Old .html URLs from the previous site. These preserve Google rankings and any
# external links. GitHub Pages cannot issue a 301, so the canonical tag is what
# actually transfers ranking signal; the meta refresh moves the visitor.
pagination:
  data: redirects
  size: 1
  alias: redirect
permalink: "{{ redirect.from }}"
excludeFromSitemap: true
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <link rel="canonical" href="{{ site.url }}{{ redirect.to }}" />
    <meta http-equiv="refresh" content="0; url={{ redirect.to }}" />
    <meta name="robots" content="noindex" />
  </head>
  <body><p>This page has moved to <a href="{{ redirect.to }}">{{ site.url }}{{ redirect.to }}</a>.</p></body>
</html>
